BFF_IMAGE=your-dockerhub-user/luxe-bff:latest
LUXE_API_URL=http://luxe-api:16800
JAVA_OPTS=-XX:MaxRAMPercentage=75
KEYCLOAK_ISSUER_URI=https://keycloak.luxe-kh.online/realms/luxe
KEYCLOAK_CLIENT_ID=luxe-ui
KEYCLOAK_CLIENT_SECRET=replace-with-a-keycloak-client-secret
KEYCLOAK_ADMIN_CLIENT_ID=luxe-admin
LUXE_ADMIN_PUBLIC_URL=https://admin.luxe-kh.online/
OAUTH2_ADMIN_REDIRECT_URI=https://admin.luxe-kh.online/bff/login/oauth2/code/keycloak-admin
